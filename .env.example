# PLANNED SETTINGS ONLY: no application currently loads this file.
# Copy to root .env during Phase 1. Paths resolve against the repository root.
# VITE_* values are public browser configuration; never put secrets in them.
VITE_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://127.0.0.1:8000
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Initial resource limits; Phase 1/3 must implement and verify enforcement.
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
ANALYSIS_MAX_DIMENSION=2048
JOB_TIMEOUT_SECONDS=120
MAX_CONCURRENT_JOBS=1
MAX_QUEUED_JOBS=4
MAX_TEMP_DATA_BYTES=536870912

# Input images are deleted immediately after analysis, including failures.
# This TTL applies to derived artifacts/results and does not extend photo retention.
TEMP_DATA_DIR=.local-data
ARTIFACT_TTL_SECONDS=3600
MODEL_ASSET_DIR=backend/models
